{
  "name": "quiz-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "pnpm implementation:check && next build && tsx scripts/check-build-traces.ts",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:recovery:tools": "vitest run --config vitest.recovery-tools.config.ts",
    "runtime:recovery": "TSX_TSCONFIG_PATH=./tsconfig.json node --conditions=react-server --import tsx scripts/runtime-recovery.ts",
    "test:e2e": "TSX_TSCONFIG_PATH=./tsconfig.json node --conditions=react-server --import tsx scripts/test-preview-e2e.ts",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "foundation:check": "tsx scripts/foundation-check.ts",
    "foundation:schema": "tsx scripts/foundation-schema.ts",
    "quizpack:check": "tsx scripts/quizpack-check.ts",
    "quizpack:build": "tsx scripts/quizpack-build.ts",
    "quizpack:schema": "tsx scripts/quizpack-schema.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:db:service": "QUIZFORGE_DB_SERVICE_SUITE=validation vitest run --config vitest.service-db.config.ts",
    "test:db:media-unknown": "QUIZFORGE_DB_SERVICE_SUITE=media-unknown vitest run --config vitest.service-db.config.ts",
    "p2a:db": "node --conditions=react-server --import tsx scripts/p2a-db.ts",
    "p2a:operator": "node --conditions=react-server --import tsx scripts/p2a-operator.ts",
    "p2a:db:ci": "node --conditions=react-server --import tsx scripts/p2a-db-ci.ts",
    "test:driver": "node --conditions=react-server --import tsx scripts/test-postgres-disconnect.ts",
    "media:build": "TSX_TSCONFIG_PATH=./tsconfig.json node --conditions=react-server --import tsx scripts/quizpack-media-build.ts",
    "media:provision": "TSX_TSCONFIG_PATH=./tsconfig.json node --conditions=react-server --import tsx scripts/quizpack-media-preflight/shared/provision-cli.ts",
    "media:fixture": "TSX_TSCONFIG_PATH=./tsconfig.json node --conditions=react-server --import tsx scripts/quizpack-media-next-fixture.ts",
    "media:setup:macos": "TSX_TSCONFIG_PATH=./tsconfig.json node --conditions=react-server --import tsx scripts/quizpack-media-preflight/macos/setup.ts",
    "media:setup:linux": "TSX_TSCONFIG_PATH=./tsconfig.json node --conditions=react-server --import tsx scripts/quizpack-media-preflight/linux/setup.mjs",
    "implementation:check": "TSX_TSCONFIG_PATH=./tsconfig.json node --conditions=react-server --import tsx scripts/check-internal-implementations.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.4.0",
    "argon2": "0.44.0",
    "buffer-crc32": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yazl": "3.3.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "patchedDependencies": {
      "postgres@3.4.9": "patches/postgres@3.4.9.patch"
    }
  }
}
